local noclipActive, infJumpActive, flyActive, tapTpEnabled = false, false, false, false
local flySpeed = 50
local noclipConnection, flyConnection = nil, nil
local flyBV, flyBG = nil, nil
local tapConn = nil

-- Точка финиша
local function GetFinishPosition()
    local success, pos = pcall(function()
        return workspace.tower.sections.finish.start.Position
    end)
    if success and pos then
        return pos + Vector3.new(0, 3, 0)
    end
    return Vector3.new(43.00, 359.84, 99.63)
end

