-- Подключение фреймворка с GitHub (как в документации)
local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/TheBloxyScripts/BloxyScripts/main/main.lua"))()

-- Создание главного окна
local Window = Library:CreateWindow({
    Name = "BloxyScripts | Tower of Hell",
    LoadingTitle = "Загрузка модулей...",
    LoadingSubtitle = "by TheBloxyScripts",
    FolderName = "BloxyConfigs"
})

-- Безопасный доступ
local Hub = Window or getgenv().CustomHub
if not Hub then
    warn("Ошибка: Главный фреймворк не инициализирован!")
    return
end

-- Сервисы
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- Точные координаты финиша (+1 по Y)
local WIN_POSITION = Vector3.new(43.00, 359.84, 99.63)

-- Переменные состояний
local godmodeActive = false
local noclipActive = false
local infJumpActive = false
local flyActive = false
local flySpeed = 50
local tapTpEnabled = false

local noclipConnection = nil
local godmodeConnection = nil
local flyConnection = nil

-- Создание вкладок
local MainTab = Window:CreateTab({EN = "Main", RU = "Главная"})
local PlayerTab = Window:CreateTab({EN = "Player", RU = "Игрок"})

-- ==================== MAIN TAB ====================
MainTab:AddSection({EN = "Tower Automation", RU = "Автоматизация башни"})

-- 1. Instant Win (Телепорт на точные координаты +1 по Y)
MainTab:AddButton({EN = "Instant Win (To Finish)", RU = "Мгновенная победа (Телепорт)"}, function()
    local character = LocalPlayer.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        character.HumanoidRootPart.CFrame = CFrame.new(WIN_POSITION)
        character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
        print("[ToH]: Мгновенная победа — телепорт на координаты!")
    end
end)

-- 2. Godmode (Бессмертие через блокировку KillScript и обработку Touch)
MainTab:AddToggle({EN = "Godmode (Anti-Death)", RU = "Режим бога (Бессмертие)"}, "GodmodeKey", false, function(state)
    godmodeActive = state
    
    if godmodeActive then
        -- Постоянный цикл отключения KillScript и бесконечного HP
        godmodeConnection = RunService.Stepped:Connect(function()
            if not godmodeActive then return end
            local character = LocalPlayer.Character
            if character then
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    humanoid.MaxHealth = math.huge
                    humanoid.Health = math.huge
                end
                
                -- Безопасное нейтрализация скриптов урона в персонаже
                for _, scriptObj in ipairs(character:GetDescendants()) do
                    if scriptObj:IsA("LocalScript") and (scriptObj.Name:lower():find("kill") or scriptObj.Name:lower():find("touch")) then
                        scriptObj.Disabled = true
                    end
                end
            end
        end)
    else
        if godmodeConnection then
            godmodeConnection:Disconnect()
            godmodeConnection = nil
        end
        local character = LocalPlayer.Character
        if character and character:FindFirstChildOfClass("Humanoid") then
            local hum = character:FindFirstChildOfClass("Humanoid")
            hum.MaxHealth = 100
            hum.Health = 100
        end
    end
end)

-- 3. NoClip (Прохождение сквозь блоки)
MainTab:AddToggle({EN = "NoClip (Walk through walls)", RU = "NoClip (Сквозь стены)"}, "NoClipKey", false, function(state)
    noclipActive = state
    if state then
        if not noclipConnection then
            noclipConnection = RunService.Stepped:Connect(function()
                if noclipActive and LocalPlayer.Character then
                    for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end
    else
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
    end
end)

-- 4. Tap / Click Teleport (Телепорт по клику мышью или тапу пальца на экране)
MainTab:AddToggle({EN = "Tap / Click Teleport", RU = "Телепорт по клику / тапу"}, "TapTpKey", false, function(state)
    tapTpEnabled = state
end)

-- Обработка нажатий экрана (Mobile) и мыши (PC)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and tapTpEnabled then
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local mouse = LocalPlayer:GetMouse()
            if mouse and mouse.Hit and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0, 3, 0))
            end
        end
    end
end)


-- ==================== PLAYER TAB ====================
PlayerTab:AddSection({EN = "Movement & Physics", RU = "Физика и полет"})

-- 5. Infinite Jump (Бесконечный прыжок)
PlayerTab:AddToggle({EN = "Infinite Jump", RU = "Бесконечный прыжок"}, "InfJumpKey", false, function(state)
    infJumpActive = state
end)

UserInputService.JumpRequest:Connect(function()
    if infJumpActive and LocalPlayer.Character then
        local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end)

-- 6. Fly / Float (Полет через BodyVelocity + BodyGyro)
PlayerTab:AddToggle({EN = "Fly Mode (BodyVelocity)", RU = "Режим полета (BodyVelocity)"}, "FlyKey", false, function(state)
    flyActive = state
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local rootPart = character.HumanoidRootPart
    
    if flyActive then
        -- Создаем BodyVelocity для движения
        local bv = Instance.new("BodyVelocity")
        bv.Name = "ToHFlyVelocity"
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.zero
        bv.Parent = rootPart
        
        -- Создаем BodyGyro для стабилизации ориентации тела
        local bg = Instance.new("BodyGyro")
        bg.Name = "ToHFlyGyro"
        bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bg.P = 9e4
        bg.CFrame = rootPart.CFrame
        bg.Parent = rootPart
        
        flyConnection = RunService.RenderStepped:Connect(function()
            if not flyActive or not rootPart:FindFirstChild("ToHFlyVelocity") then return end
            
            local cam = workspace.CurrentCamera
            local moveDir = Vector3.zero
            
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0, 1, 0) end
            
            rootPart.ToHFlyVelocity.Velocity = moveDir * flySpeed
            if rootPart:FindFirstChild("ToHFlyGyro") then
                rootPart.ToHFlyGyro.CFrame = cam.CFrame
            end
        end)
    else
        if flyConnection then flyConnection:Disconnect() flyConnection = nil end
        if rootPart:FindFirstChild("ToHFlyVelocity") then rootPart.ToHFlyVelocity:Destroy() end
        if rootPart:FindFirstChild("ToHFlyGyro") then rootPart.ToHFlyGyro:Destroy() end
    end
end)

-- Настройка скорости полета
PlayerTab:AddSlider({EN = "Fly Speed", RU = "Скорость полета"}, "FlySpeedKey", 20, 200, 50, function(value)
    flySpeed = value
end)

-- 7. WalkSpeed Slider
PlayerTab:AddSlider({EN = "WalkSpeed", RU = "Скорость бега"}, "SpeedKey", 16, 150, 16, function(value)
    local character = LocalPlayer.Character
    if character and character:FindFirstChildOfClass("Humanoid") then
        character:FindFirstChildOfClass("Humanoid").WalkSpeed = value
    end
end)

-- 8. JumpPower Slider
PlayerTab:AddSlider({EN = "JumpPower", RU = "Высота прыжка"}, "JumpKey", 50, 300, 50, function(value)
    local character = LocalPlayer.Character
    if character and character:FindFirstChildOfClass("Humanoid") then
        local hum = character:FindFirstChildOfClass("Humanoid")
        hum.UseJumpPower = true
        hum.JumpPower = value
    end
end)

MainTab:AddLabel({EN = "Status: Tower of Hell Loaded", RU = "Статус: Скрипт загружен"})
